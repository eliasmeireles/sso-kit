{
  "name": "@eliasmeireles/sso-kit",
  "version": "0.2.0",
  "description": "OIDC Authorization Code + PKCE helpers for Node backends-for-frontend and browser public clients",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/test-support/**",
    "README.md"
  ],
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "default": "./dist/server/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "default": "./dist/browser/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/**/*.test.js"
  },
  "dependencies": {
    "oauth4webapi": "^3.8.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jose": "^6.2.15",
    "typescript": "^5.9.3"
  }
}
